{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "winter",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b0084720-13da-4f54-a7d5-a0911d32cf13","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "fb7729c7b950421d8fb457459c7575eb" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
